{
	"name": "@guessless/mcp",
	"version": "1.0.0",
	"bin": {
		"guessless-mcp": "./dist/server.js"
	},
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./server": "./dist/server.js"
	},
	"dependencies": {
		"@guessless/engine": "workspace:*",
		"@modelcontextprotocol/sdk": "catalog:",
		"pathe": "catalog:",
		"ufo": "catalog:",
		"zod": "catalog:"
	},
	"description": "MCP stdio server exposing guessless structural receipts to agent harnesses.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thejackshelton/guessless.git",
		"directory": "packages/mcp"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
