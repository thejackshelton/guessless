is phase missed\npackages/frameworks/react/test/emitter.test.ts:2080:\t\t// the one file that actually broke.\npackages/frameworks/react/test/emitter.test.ts:2081:\t\ttest('CONSUMES the authored prop type, and prints NOTHING when it is absent', async () => {\npackages/frameworks/react/test/emitter.test.ts:2082:\t\t\tconst ir = clone(await golden('s1-render-once.json'));\npackages/frameworks/react/test/emitter.test.ts:2083:\t\t\texpect(ir.components[0]!.props.entries.some((entry) => entry.type)).toBe(true);\npackages/frameworks/react/test/emitter.test.ts:2084:\t\t\texpect(() => validateEnrichedIr(ir)).not.toThrow();\npackages/frameworks/react/test/emitter.test.ts:2085:\t\t\tconst stripped = clone(ir) as any;\npackages/frameworks/react/test/emitter.test.ts:2086:\t\t\t// BOTH IR-8 FIELDS COME OFF TOGETHER. `type` and `optional` are read\npackages/frameworks/react/test/emitter.test.ts:2087:\t\t\t// from one `TSPropertySignature` and the validator rejects one without\npackages/frameworks/react/test/emitter.test.ts:2088:\t\t\t// the other, so stripping only `type` no longer produces a lawful IR -\npackages/frameworks/react/test/emitter.test.ts:2089:\t\t\t// it produces requiredness with nothing to attach to.\npackages/frameworks/react/test/emitter.test.ts:2090:\t\t\tfor (const entry of stripped.components[0].props.entries) {\npackages/frameworks/react/test/emitter.test.ts:2091:\t\t\t\tdelete entry.type;\npackages/frameworks/react/test/emitter.test.ts:2092:\t\t\t\tdelete entry.optional;\npackages/frameworks/react/test/emitter.test.ts:2093:\t\t\t}\npackages/frameworks/react/test/emitter.test.ts:2094:\t\t\t// REWRITTEN AT `frameless-emitter-capability-v1` T014, NOT EXTENDED. Until\npackages/frameworks/react/test/emitter.test.ts:2095:\t\t\t// this step the row asserted `emit(ir) === emit(stripped)` - \"admitted but\npackages/frameworks/react/test/emitter.test.ts:2096:\t\t\t// not printed\" - and that assertion is now FALSE BY DESIGN, because Step 2\npackages/frameworks/react/test/emitter.test.ts:2097:\t\t\t// is the step that prints. A row that kept passing here would have been\npackages/frameworks/react/test/emitter.test.ts:2098:\t\t\t// pinning the hole the phase exists to close.\npackages/frameworks/react/test/emitter.test.ts:2099:\t\t\t//\npackages/frameworks/react/test/emitter.test.ts:2100:\t\t\t// The pair is what makes it a measurement rather than a text check: the\npackages/frameworks/react/test/emitter.test.ts:2101:\t\t\t// SAME IR with the annotation prints the authored type, and WITHOUT it\npackages/frameworks/react/test/emitter.test.ts:2102:\t\t\t// prints no annotation at all. So an emitter that synthesized a type from\npackages/frameworks/react/test/emitter.test.ts:2103:\t\t\t// how the corpus uses the prop fails the second arm, and an emitter that\npackages/frameworks/react/test/emitter.test.ts:2104:\t\t\t// dropped IR-8 on the floor fails the first.\npackages/frameworks/react/test/emitter.test.ts:2105:\t\t\tconst typed = emit(ir);\npackages/frameworks/react/test/emitter.test.ts:2106:\t\t\tconst untyped = emit(stripped);\npackages/frameworks/react/test/emitter.test.ts:2107:\t\t\texpect(typed).not.toBe(untyped);\npackages/frameworks/react/test/emitter.test.ts:2108:\t\t\texpect(typed).toContain('label: string');\npackages/frameworks/react/test/emitter.test.ts:2109:\t\t\texpect(typed).toContain('multiplier: number');\npackages/frameworks/react/test/emitter.test.ts:2110:\t\t\texpect(typed).toContain('visible: boolean');\npackages/frameworks/react/test/emitter.test.ts:2111:\t\t\texpect(typed).toContain('onTrace: (name: string, detail: Record<string, unknown>) => void');\npackages/frameworks/react/test/emitter.test.ts:2112:\t\t\texpect(untyped).not.toContain('string');\npackages/frameworks/react/test/emitter.test.ts:2113:\t\t\texpect(untyped).toContain('{ label, multiplier, visible, onTrace }');\npackages/frameworks/react/test/emitter.test.ts:2114:\t\t\t// ALL-OR-NOTHING. One prop losing its annotation suppresses the whole\npac