p((match) => match[1]!);\npackages/frameworks/react/test/adapter-entry.test.ts:23:\t\t\texpect(imports.filter((specifier) => specifier.startsWith('node:')), file).toEqual([]);\npackages/frameworks/react/test/adapter-entry.test.ts:24:\t\t\texpect(imports, file).not.toContain('eslint');\npackages/frameworks/react/test/adapter-entry.test.ts:25:\t\t\tfor (const specifier of imports.filter((entry) => entry.startsWith('.'))) {\npackages/frameworks/react/test/adapter-entry.test.ts:26:\t\t\t\tpending.push(resolve(file, '..', specifier));\npackages/frameworks/react/test/adapter-entry.test.ts:27:\t\t\t}\npackages/frameworks/react/test/adapter-entry.test.ts:28:\t\t}\npackages/frameworks/react/test/adapter-entry.test.ts:29:\t\texpect([...visited]).toEqual([resolve(root, 'src/adapter.ts')]);\npackages/frameworks/react/test/adapter-entry.test.ts:30:\t});\npackages/frameworks/react/test/adapter-entry.test.ts:31:});\npackages/frameworks/react/test/action-order.browser.test.ts:1:import { compareRuns, runScenario, scenarioById } from '@frameless/analyzer';\npackages/frameworks/react/test/action-order.browser.test.ts:2:import { createReactAdapter } from '@frameless/react/adapter';\npackages/frameworks/react/test/action-order.browser.test.ts:3:import { describe, expect, test } from 'vitest';\npackages/frameworks/react/test/action-order.browser.test.ts:4:import { EventForm } from '../generated/S3.jsx';\npackages/frameworks/react/test/action-order.browser.test.ts:5:import { reactReferences } from './reference.tsx';\npackages/frameworks/react/test/action-order.browser.test.ts:6:\npackages/frameworks/react/test/action-order.browser.test.ts:7:// RANDOMISED ACTION ORDERING (audit item 11).\npackages/frameworks/react/test/action-order.browser.test.ts:8://\npackages/frameworks/react/test/action-order.browser.test.ts:9:// This is the concrete, implementable form of what the owner called \"jitter\npackages/frameworks/react/test/action-order.browser.test.ts:10:// testing\". That is not standard compiler terminology - it is an SRE term for\npackages/frameworks/react/test/action-order.browser.test.ts:11:// timing variance - but the instinct behind it is sound, and the strategy audit\npackages/frameworks/react/test/action-order.browser.test.ts:12:// re-grounded it as three things: a StrictMode lane (shipped in T007),\npackages/frameworks/react/test/action-order.browser.test.ts:13:// network-throttled Qwik resumption (still open), and this.\npackages/frameworks/react/test/action-order.browser.test.ts:14://\npackages/frameworks/react/test/action-order.browser.test.ts:15:// The scenarios drive ONE fixed action sequence. That is a real limit: a\npackages/frameworks/react/test/action-order.browser.test.ts:16:// divergence that only appears when a user clicks in a different order is\npackages/frameworks/react/test/action-order.browser.test.ts:17:// invisible to the whole suite today.\npackages/frameworks/react/test/action-order.browser.test.ts:18://\npackages/frameworks/react/test/action-order.browser.test.ts:19:// The invariant asserted here does NOT require knowing which actions commute -\npackages/frameworks/react/test/action-order.browser.test.ts:20:// which matters, because most of S2's do not. It is simply:\npackages/frameworks/react/test/action-order.browser.test.ts:21://\npackages/frameworks/react/test/action-order.browser.test.ts:22://     for ANY order of actions, emitted output and the handwritten reference\npackages/frameworks/react/test/action-order.browser.test.ts:23://     must still agree.\npackages/frameworks/react/test/action-order.browser.test.ts:24://\npackages/frameworks/react/test/action-order.browser.test.ts:25:// The end state may differ wildly from the scripted run. That is fine and is not\npackages/frameworks/react/test/action-order.browser.test.ts:26:// what is being checked. What must hold is that both implementations get there\npackages/frameworks/react/test/action-order.browser.test.ts:27:// the same way, in DOM, callbacks, list identity and focus.\npackages/frameworks/react/test/action-order.browser.test.ts:28:\npackages/frameworks/react/test/action-order.browser.test.ts:29:const permutations = <T,>(items: readonly T[], seed: number): T[] => {\npackages/frameworks/react/test/action-order.browser.test.ts:30:\t// Deterministic shuffle: a fixed seed keeps CI reproducible, and a failure is\npackages/frameworks/react/test/action-order.browser.test.ts:31:\t// reported with the seed so it can be replayed.\npackages/frameworks/react/test/action-order.browser.test.ts:32:\tconst next = (state: number) => (state * 1103515245 + 12345) % 2147483648;\npackages/frameworks/react/test/action-order.browser.test.ts:33:\tconst out = [...items];\npackages/frameworks/react/test/action-order.browser.test.ts:34:\tlet state = seed;\npackages/frameworks/react/test/action-order.browser.test.ts:35:\tfor (let index = out.length - 1; index > 0; index--) {\npackages/frameworks/react/test/action-order.browser.test.ts:36:\t\tstate = next(state);\npackages/frameworks/react/test/action-order.browser.test.ts:37:\t\tconst swap = state % (index + 1);\npackages/frameworks/react/test/action-order.browser.test.ts:38:\t\t[out[index], out[swap]] = [out[swap]!, out[index]!];\npackages/frameworks/react/test/action-order.browser.test.ts:39:\t}\npackages/frameworks/react/test/action-order.browser.test.ts:40:\treturn out;\npackages/frameworks/react/test/action-order.browser.test.ts:41:};\npackages/frameworks/react/test/action-order.browser.test.ts:42:\npackages/frameworks/react/test/action-order.browser.test.ts:43:// S3 only. S2's actions are NOT order-independent: they add an item, then edit,\npackages/frameworks/react/test/action-order.browser.test.ts:44:// toggle, reorder and remove it by id. An arbitrary permutation asks the adapter\npackages/frameworks/react/test/action-order.browser.test.ts:45:// to target an element that does not exist yet, which THROWS rather than\npackages/frameworks/react/test/action-order.browser.test.ts:46:// diver