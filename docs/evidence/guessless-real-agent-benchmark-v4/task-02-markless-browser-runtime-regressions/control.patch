+++ b/packages/compiler/src/passes/public-render/authored-expressions.ts
@@ -0,0 +1,22 @@
+import type { PublicRenderModuleInput } from '../../artifacts.ts';
+
+// This is the single compiler-owned inventory for executable render-data
+// residues. SSR and the linked client render-data module consume the same list;
+// neither runtime parses or interprets authored source.
+export function authoredExpressionSources(
+	input: PublicRenderModuleInput,
+	componentName: string,
+): ReadonlyArray<string> {
+	const sources = new Set<string>();
+	for (const chunk of input.renderData.chunks.filter((item) => item.componentName === componentName)) {
+		for (const slot of chunk.slots) {
+			if ('residue' in slot && slot.residue.kind === 'authored-expression') sources.add(slot.residue.source);
+			if (slot.kind !== 'dynamic-host') continue;
+			if (slot.tag.kind === 'authored-expression') sources.add(slot.tag.source);
+			for (const attribute of slot.attributeSlots) {
+				if (attribute.residue.kind === 'authored-expression') sources.add(attribute.residue.source);
+			}
+		}
+	}
+	return [...sources];
+}
