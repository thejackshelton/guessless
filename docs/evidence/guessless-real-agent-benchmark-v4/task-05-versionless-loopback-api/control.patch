diff --git a/packages/cli/test/witness-static-server.test.ts b/packages/cli/test/witness-static-server.test.ts
new file mode 100644
index 0000000..25ce7d2
--- /dev/null
+++ b/packages/cli/test/witness-static-server.test.ts
@@ -0,0 +1,142 @@
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { connect } from 'node:net';
+import { tmpdir } from 'node:os';
+import { join } from 'pathe';
+import { parseHost, parseURL } from 'ufo';
+import { describe, expect, it } from 'vitest';
+import { startStaticServer, type StaticApiRequest } from '../src/witness/real-app-run.ts';
+import { projectWitnessTransportRequest } from '../src/witness/playwright-host.ts';
+
+async function fixtureRoot(): Promise<string> {
+	const root = await mkdtemp(join(tmpdir(), 'versionless-static-server-'));
+	await writeFile(join(root, 'index.html'), 'static index');
+	return root;
+}
+
+async function upgrade(origin: string, path: string, head: string): Promise<void> {
+	const parsed = parseURL(origin);
+	const host = parseHost(parsed.host ?? '');
+	await new Promise<void>((resolve, reject) => {
+		const socket = connect(Number(host.port), host.hostname, () => {
+			socket.write(
+				`GET ${path} HTTP/1.1\r\nHost: ${parsed.host}\r\nConnection: Upgrade\r\nUpgrade: witness\r\n\r\n${head}`,
+			);
+		});
+		socket.once('error', reject);
+		socket.once('close', () => resolve());
+	});
+}
+
+describe('production-static witness server loopback seams', () => {
+	it('preserves the exact query in Playwright transport projection', () => {
+		expect(
+			projectWitnessTransportRequest(
+				'https://api.example.test/items?raw=a%2Bb&raw=c#ignored',
+				'POST',
+				'fetch',
+			),
+		).toMatchObject({
+			pathname: '/items',
+			query: '?raw=a%2Bb&raw=c',
+			method: 'POST',
+		});
+	});
+
+	it('projects API responses, declines to static serving, and ledgers both honestly', async () => {
+		const root = await fixtureRoot();
+		const seen: StaticApiRequest[] = [];
+		const server = await startStaticServer(root, {
+			apiHandler: (request) => {
+				seen.push(request);
+				if (request.pathname !== '/api/value') return undefined;
+				return {
+					status: 201,
+					contentType: 'application/json',
+					body: Buffer.from('{"projected":true}'),
+				};
+			},
+		});
+		try {
+			const projected = await fetch(`${server.origin}/api/value?raw=a%2Bb&raw=c`);
+			expect(projected.status).toBe(201);
+			expect(await projected.text()).toBe('{"projected":true}');
+			const fallback = await fetch(`${server.origin}/?cache=kept`);
+			expect(await fallback.text()).toBe('static index');
+			expect(seen).toEqual([
+				{ method: 'GET', pathname: '/api/value', query: '?raw=a%2Bb&raw=c' },
+				{ method: 'GET', pathname: '/', query: '?cache=kept' },
+			]);
+			expect(server.ledger()).toMatchObject([
+				{
+					pathname: '/api/value',
+					query: '?raw=a%2Bb&raw=c',
+					resolvedFile: null,
+					status: 201,
+				},
+				{ pathname: '/', query: '?cache=kept', resolvedFile: 'index.html', status: 200 },
+			]);
+			server.assertClean();
+		} finally {
+			await server.close();
+			await rm(root, { recursive: true, force: true });
+		}
+	});
+
+	it('records an API failure response without strengthening server health', async () => {
+		const root = await fixtureRoot();
+		const server = await startStaticServer(root, {
+			apiHandler: () => {
+				throw new Error('projection failed');
+			},
+		});
+		try {
+			const response = await fetch(`${server.origin}/api/failure?attempt=1`);
+			expect(response.status).toBe(500);
+			expect(await response.text()).toBe('static server failure');
+			expect(server.ledger()).toMatchObject([
+				{
+					pathname: '/api/failure',
+					query: '?attempt=1',
+					resolvedFile: null,
+					status: 500,
+					mime: 'text/plain',
+				},
+			]);
+			expect(() => server.assertClean()).toThrow('projection failed');
+		} finally {
+			await server.close();
+			await rm(root, { recursive: true, force: true });
+		}
+	});
+
+	it('passes upgrade request/socket/head and fail-closes rejected upgrades', async () => {
+		const root = await fixtureRoot();
+		let observation: { url: string; head: string } | undefined;
+		const accepted = await startStaticServer(root, {
+			upgradeHandler: (request, socket, head) => {
+				observation = { url: request.url ?? '', head: head.toString('utf8') };
+				socket.end('HTTP/1.1 101 Switching Protocols\r\nConnection: close\r\n\r\n');
+			},
+		});
+		try {
+			await upgrade(accepted.origin, '/socket?mode=exact', 'head-bytes');
+			expect(observation).toEqual({ url: '/socket?mode=exact', head: 'head-bytes' });
+			accepted.assertClean();
+		} finally {
+			await accepted.close();
+		}
+
+		const rejected = await startStaticServer(root, {
+			upgradeHandler: () => {
+				throw new Error('upgrade rejected');
+			},
+		});
+		try {
+			await upgrade(rejected.origin, '/socket', '');
+			expect(() => rejected.assertClean()).toThrow('upgrade rejected');
+		} finally {
+			await rejected.close();
+			await rm(root, { recursive: true, force: true });
+		}
+	});
+});
