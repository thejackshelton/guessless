diff --git a/packages/cli/src/fixture/react-papercups-aggregate.ts b/packages/cli/src/fixture/react-papercups-aggregate.ts
new file mode 100644
index 0000000..b588b84
--- /dev/null
+++ b/packages/cli/src/fixture/react-papercups-aggregate.ts
@@ -0,0 +1,159 @@
+import { readFile, rename, unlink, writeFile } from 'node:fs/promises';
+import * as path from 'pathe';
+import {
+	canonicalize,
+	deriveCorpusTransactionState,
+	reactPapercupsAggregateMember,
+	verifyWitnessReactPapercupsEvidence,
+	witnessReactPapercupsAggregateMember,
+} from '../../../core/src/index.ts';
+
+const aggregateRelativePath = 'evidence/runs/aggregate.json';
+const stageSuffix = '.papercups-append.tmp';
+
+type Aggregate = {
+	schemaVersion: 'versionless.aggregate.v1';
+	fixtures: Array<Record<string, unknown>>;
+	unsupported: unknown[];
+};
+
+export type PapercupsAggregateMode = 'append' | 'verify-only';
+export type PapercupsAggregateResult = Readonly<{
+	result: 'pass';
+	mode: PapercupsAggregateMode;
+	state: 'appended' | 'already-appended' | 'verified';
+	members: readonly [string, string];
+}>;
+
+export type PapercupsAggregateFileOperations = Readonly<{
+	rename(oldPath: string, newPath: string): Promise<void>;
+}>;
+
+function parseAggregate(value: unknown): Aggregate {
+	if (value === null || typeof value !== 'object' || Array.isArray(value))
+		throw new Error('Papercups aggregate must be an object');
+	const aggregate = value as Partial<Aggregate>;
+	if (
+		aggregate.schemaVersion !== 'versionless.aggregate.v1' ||
+		!Array.isArray(aggregate.fixtures) ||
+		!Array.isArray(aggregate.unsupported) ||
+		aggregate.unsupported.length !== 0 ||
+		Object.keys(aggregate).sort().join(',') !== 'fixtures,schemaVersion,unsupported'
+	)
+		throw new Error('Papercups aggregate envelope differs');
+	return aggregate as Aggregate;
+}
+
+async function readAggregate(file: string): Promise<Aggregate> {
+	return parseAggregate(JSON.parse(await readFile(file, 'utf8')) as unknown);
+}
+
+export async function derivePapercupsAggregateMembers(rootDir = '.') {
+	const verified = await verifyWitnessReactPapercupsEvidence(rootDir);
+	return [
+		reactPapercupsAggregateMember(verified.receipt.canonicalReceipt.canonicalDigest),
+		witnessReactPapercupsAggregateMember(verified.digest),
+	] as const;
+}
+
+function classify(
+	aggregate: Aggregate,
+	members: Awaited<ReturnType<typeof derivePapercupsAggregateMembers>>,
+): 'predecessor' | 'appended' {
+	const transaction = deriveCorpusTransactionState(aggregate.fixtures);
+	if (transaction.kind === 'react-zero-sw-reconciliation') return 'predecessor';
+	if (transaction.kind !== 'react-papercups-browser-proof')
+		throw new Error('Papercups aggregate is not an accepted transaction state');
+	const expected = {
+		...aggregate,
+		fixtures: [...aggregate.fixtures.slice(0, -2), ...members],
+	};
+	if (canonicalize(expected) !== canonicalize(aggregate))
+		throw new Error('Papercups aggregate members differ from published evidence');
+	return 'appended';
+}
+
+export async function updatePapercupsAggregate(options: {
+	rootDir?: string;
+	mode: PapercupsAggregateMode;
+	operations?: PapercupsAggregateFileOperations;
+}): Promise<PapercupsAggregateResult> {
+	const root = path.resolve(options.rootDir ?? '.');
+	const target = path.join(root, aggregateRelativePath);
+	const staged = `${target}${stageSuffix}`;
+	const operations = options.operations ?? { rename };
+	const members = await derivePapercupsAggregateMembers(root);
+	const initial = await readAggregate(target);
+	const initialState = classify(initial, members);
+	const memberIds = [members[0].id, members[1].id] as const;
+
+	if (options.mode === 'verify-only') {
+		if (initialState !== 'appended')
+			throw new Error('Papercups aggregate has not been appended');
+		return {
+			result: 'pass',
+			mode: options.mode,
+			state: 'verified',
+			members: memberIds,
+		};
+	}
+	if (initialState === 'appended')
+		return {
+			result: 'pass',
+			mode: options.mode,
+			state: 'already-appended',
+			members: memberIds,
+		};
+
+	let ownsStage = false;
+	try {
+		const appended: Aggregate = { ...initial, fixtures: [...initial.fixtures, ...members] };
+		await writeFile(staged, `${JSON.stringify(appended, null, 2)}\n`, { flag: 'wx' });
+		ownsStage = true;
+
+		// Re-read both evidence and aggregate after staging. A concurrent edit or
+		// evidence drift must be detected before the atomic replacement.
+		const freshMembers = await derivePapercupsAggregateMembers(root);
+		const freshTarget = await readAggregate(target);
+		if (classify(freshTarget, freshMembers) !== 'predecessor')
+			throw new Error('Papercups aggregate changed while append was staged');
+		const freshStage = await readAggregate(staged);
+		const expectedStage: Aggregate = {
+			...freshTarget,
+			fixtures: [...freshTarget.fixtures, ...freshMembers],
+		};
+		if (canonicalize(freshStage) !== canonicalize(expectedStage))
+			throw new Error('Papercups staged aggregate differs after re-derivation');
+		if (classify(freshStage, freshMembers) !== 'appended')
+			throw new Error('Papercups staged aggregate is inconsistent');
+
+		await operations.rename(staged, target);
+		ownsStage = false;
+		const published = await readAggregate(target);
+		const publishedMembers = await derivePapercupsAggregateMembers(root);
+		if (classify(published, publishedMembers) !== 'appended')
+			throw new Error('Papercups aggregate publication differs');
+		return {
+			result: 'pass',
+			mode: options.mode,
+			state: 'appended',
+			members: memberIds,
+		};
+	} catch (error) {
+		if (ownsStage) await unlink(staged).catch(() => undefined);
+		throw error;
+	}
+}
+
+export async function main(args = process.argv.slice(2)): Promise<void> {
+	if (args.length !== 1 || (args[0] !== '--append' && args[0] !== '--verify-only'))
+		throw new Error('Papercups aggregate requires exactly --append or --verify-only');
+	const mode = args[0] === '--append' ? 'append' : 'verify-only';
+	process.stdout.write(`${JSON.stringify(await updatePapercupsAggregate({ mode }))}\n`);
+}
+
+if (process.argv[1]?.endsWith('react-papercups-aggregate.ts'))
+	main().catch((error: unknown) => {
+		process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
+		process.exitCode = 1;
+	});
