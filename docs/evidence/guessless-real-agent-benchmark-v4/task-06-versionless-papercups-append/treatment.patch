diff --git a/packages/cli/test/react-papercups-aggregate.test.ts b/packages/cli/test/react-papercups-aggregate.test.ts
new file mode 100644
index 0000000..dd1cd88
--- /dev/null
+++ b/packages/cli/test/react-papercups-aggregate.test.ts
@@ -0,0 +1,121 @@
+import { cp, mkdir, mkdtemp, readFile, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import * as path from 'pathe';
+import { describe, expect, it } from 'vitest';
+import {
+	derivePapercupsAggregateMembers,
+	updatePapercupsAggregate,
+} from '../src/fixture/react-papercups-aggregate.ts';
+
+const root = path.resolve(import.meta.dirname, '../../..');
+
+async function workspace(): Promise<string> {
+	const directory = await mkdtemp(path.join(tmpdir(), 'versionless-papercups-aggregate-'));
+	for (const relative of [
+		'evidence/runs/aggregate.json',
+		'evidence/runs/react-papercups-v1-0-0/t004-run.json',
+		'evidence/runs/witness-react-papercups/receipt.json',
+		'evidence/runs/witness-react-papercups/receipt.md',
+	]) {
+		const target = path.join(directory, relative);
+		await mkdir(path.dirname(target), { recursive: true });
+		await cp(path.join(root, relative), target, { recursive: true });
+	}
+	return directory;
+}
+
+async function aggregate(directory: string) {
+	return JSON.parse(
+		await readFile(path.join(directory, 'evidence/runs/aggregate.json'), 'utf8'),
+	) as { fixtures: Array<Record<string, unknown>> };
+}
+
+async function publishAggregate(directory: string, value: unknown): Promise<void> {
+	await writeFile(
+		path.join(directory, 'evidence/runs/aggregate.json'),
+		`${JSON.stringify(value, null, 2)}\n`,
+	);
+}
+
+describe('Papercups canonical aggregate append', () => {
+	it('derives both members from the published migration and browser evidence', async () => {
+		const members = await derivePapercupsAggregateMembers(root);
+		expect(members.map((member) => member.id)).toEqual([
+			'react-papercups-v1-0-0',
+			'witness-react-papercups',
+		]);
+		expect(members.map((member) => member.digest)).toEqual([
+			'b433f214727389676b308332f7689d773ad28dde0984b9bf245f3f780f87d35a',
+			'abd33d566ecef3ce4b24470c3105320520a712db19351f74b6c887b63227f267',
+		]);
+	});
+
+	it('atomically appends the exact pair and supports verify-only', async () => {
+		const directory = await workspace();
+		await expect(
+			updatePapercupsAggregate({ rootDir: directory, mode: 'append' }),
+		).resolves.toMatchObject({ result: 'pass', state: 'appended' });
+		const value = await aggregate(directory);
+		expect(value.fixtures).toHaveLength(18);
+		expect(value.fixtures.slice(-2).map((member) => member.id)).toEqual([
+			'react-papercups-v1-0-0',
+			'witness-react-papercups',
+		]);
+		await expect(
+			updatePapercupsAggregate({ rootDir: directory, mode: 'verify-only' }),
+		).resolves.toMatchObject({ result: 'pass', state: 'verified' });
+	});
+
+	it('is idempotent once the exact browser-proof state is complete', async () => {
+		const directory = await workspace();
+		await updatePapercupsAggregate({ rootDir: directory, mode: 'append' });
+		const before = await readFile(path.join(directory, 'evidence/runs/aggregate.json'));
+		await expect(
+			updatePapercupsAggregate({ rootDir: directory, mode: 'append' }),
+		).resolves.toMatchObject({ state: 'already-appended' });
+		expect(await readFile(path.join(directory, 'evidence/runs/aggregate.json'))).toEqual(before);
+	});
+
+	it('refuses partial, reordered, inconsistent, and not-yet-appended states', async () => {
+		const members = await derivePapercupsAggregateMembers(root);
+		for (const tail of [
+			[members[0]],
+			[members[1]],
+			[members[1], members[0]],
+			[members[0], { ...members[1], digest: '0'.repeat(64) }],
+		]) {
+			const directory = await workspace();
+			const value = await aggregate(directory);
+			value.fixtures.push(...tail);
+			await publishAggregate(directory, value);
+			await expect(
+				updatePapercupsAggregate({ rootDir: directory, mode: 'append' }),
+			).rejects.toThrow();
+		}
+		const predecessor = await workspace();
+		await expect(
+			updatePapercupsAggregate({ rootDir: predecessor, mode: 'verify-only' }),
+		).rejects.toThrow('has not been appended');
+	});
+
+	it('removes exclusive staging residue when atomic publication fails', async () => {
+		const directory = await workspace();
+		const target = path.join(directory, 'evidence/runs/aggregate.json');
+		const before = await readFile(target);
+		await expect(
+			updatePapercupsAggregate({
+				rootDir: directory,
+				mode: 'append',
+				operations: {
+					rename: async (_oldPath, _newPath) => {
+						throw new Error('injected rename failure');
+					},
+				},
+			}),
+		).rejects.toThrow('injected rename failure');
+		expect(await readFile(target)).toEqual(before);
+		await expect(readFile(`${target}.papercups-append.tmp`)).rejects.toMatchObject({
+			code: 'ENOENT',
+		});
+	});
+});
