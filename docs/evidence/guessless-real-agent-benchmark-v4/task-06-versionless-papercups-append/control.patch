diff --git a/packages/cli/src/corpus/react-papercups-aggregate.ts b/packages/cli/src/corpus/react-papercups-aggregate.ts
new file mode 100644
index 0000000..065d7ab
--- /dev/null
+++ b/packages/cli/src/corpus/react-papercups-aggregate.ts
@@ -0,0 +1,143 @@
+import { readFile, rename, rm, writeFile } from 'node:fs/promises';
+import { join, resolve } from 'pathe';
+import { canonicalize, sha256 } from '../../../core/src/receipts/canonicalize.ts';
+import { deriveCorpusTransactionState } from '../../../core/src/corpus/conformance.ts';
+import {
+	reactPapercupsAggregateMember,
+	verifyWitnessReactPapercupsEvidence,
+	witnessReactPapercupsAggregateMember,
+} from '../../../core/src/receipts/witness-react-papercups.ts';
+
+const predecessorKind = 'react-zero-sw-reconciliation' as const;
+const completedKind = 'react-papercups-browser-proof' as const;
+
+type Aggregate = {
+	schemaVersion: 'versionless.aggregate.v1';
+	fixtures: unknown[];
+	unsupported: unknown[];
+};
+
+export type ReactPapercupsAggregateResult = {
+	result: 'appended' | 'already-appended' | 'verified-predecessor' | 'verified-complete';
+	mode: 'append' | 'verify-only';
+	state: typeof predecessorKind | typeof completedKind;
+	members: Array<{
+		id: string;
+		framework: string;
+		track: string;
+		bundler: string;
+		runtime: string;
+		result: string;
+		receipt: string;
+		digest: string;
+	}>;
+	aggregateSha256: string;
+};
+
+function parseAggregate(bytes: Buffer): Aggregate {
+	const value = JSON.parse(bytes.toString('utf8')) as Partial<Aggregate>;
+	if (
+		value === null ||
+		typeof value !== 'object' ||
+		value.schemaVersion !== 'versionless.aggregate.v1' ||
+		!Array.isArray(value.fixtures) ||
+		!Array.isArray(value.unsupported) ||
+		value.unsupported.length !== 0 ||
+		Object.keys(value).sort().join(',') !== 'fixtures,schemaVersion,unsupported'
+	)
+		throw new Error('Canonical aggregate envelope differs');
+	return value as Aggregate;
+}
+
+function acceptedState(aggregate: Aggregate): typeof predecessorKind | typeof completedKind {
+	const state = deriveCorpusTransactionState(aggregate.fixtures).kind;
+	if (state !== predecessorKind && state !== completedKind)
+		throw new Error('Canonical aggregate is not an exact Papercups predecessor or completed state');
+	return state;
+}
+
+export async function deriveReactPapercupsAggregateMembers(rootDir = '.') {
+	const evidence = await verifyWitnessReactPapercupsEvidence(rootDir);
+	return [
+		reactPapercupsAggregateMember(evidence.receipt.canonicalReceipt.canonicalDigest),
+		witnessReactPapercupsAggregateMember(evidence.digest),
+	];
+}
+
+function assertCompletedMembers(aggregate: Aggregate, expected: unknown[]): void {
+	if (
+		aggregate.fixtures.length < expected.length ||
+		canonicalize(aggregate.fixtures.slice(-expected.length)) !== canonicalize(expected)
+	)
+		throw new Error('Canonical aggregate Papercups membership differs from published evidence');
+}
+
+/**
+ * Appends the evidence-derived Papercups pair as one filesystem transaction.
+ * The fixed sibling stage is exclusively created, making concurrent writers
+ * fail closed instead of sharing or overwriting staging bytes.
+ */
+export async function updateReactPapercupsAggregate(options: {
+	rootDir?: string;
+	mode: 'append' | 'verify-only';
+	aggregatePath?: string;
+	operations?: { rename: typeof rename };
+}): Promise<ReactPapercupsAggregateResult> {
+	const root = resolve(options.rootDir ?? '.');
+	const aggregatePath = resolve(options.aggregatePath ?? join(root, 'evidence/runs/aggregate.json'));
+	const stagePath = `${aggregatePath}.react-papercups.stage`;
+	const initialBytes = await readFile(aggregatePath);
+	const initial = parseAggregate(initialBytes);
+	const initialState = acceptedState(initial);
+	const members = await deriveReactPapercupsAggregateMembers(root);
+
+	if (initialState === completedKind) {
+		assertCompletedMembers(initial, members);
+		return {
+			result: options.mode === 'append' ? 'already-appended' : 'verified-complete',
+			mode: options.mode,
+			state: completedKind,
+			members,
+			aggregateSha256: sha256(initialBytes),
+		};
+	}
+	if (options.mode === 'verify-only')
+		return {
+			result: 'verified-predecessor',
+			mode: options.mode,
+			state: predecessorKind,
+			members,
+			aggregateSha256: sha256(initialBytes),
+		};
+
+	const next: Aggregate = { ...initial, fixtures: [...initial.fixtures, ...members] };
+	if (acceptedState(next) !== completedKind) throw new Error('Derived Papercups aggregate is invalid');
+	const stagedBytes = Buffer.from(`${JSON.stringify(next, null, 2)}\n`);
+	let stageCreated = false;
+	try {
+		await writeFile(stagePath, stagedBytes, { flag: 'wx' });
+		stageCreated = true;
+		const rereadBytes = await readFile(aggregatePath);
+		if (!rereadBytes.equals(initialBytes))
+			throw new Error('Canonical aggregate changed while Papercups append was staged');
+		if (acceptedState(parseAggregate(rereadBytes)) !== predecessorKind)
+			throw new Error('Canonical aggregate predecessor changed while append was staged');
+		const rederived = await deriveReactPapercupsAggregateMembers(root);
+		if (canonicalize(rederived) !== canonicalize(members))
+			throw new Error('Published Papercups evidence changed while append was staged');
+		const staged = parseAggregate(await readFile(stagePath));
+		if (acceptedState(staged) !== completedKind) throw new Error('Staged aggregate is invalid');
+		assertCompletedMembers(staged, rederived);
+		await (options.operations?.rename ?? rename)(stagePath, aggregatePath);
+		stageCreated = false;
+		return {
+			result: 'appended',
+			mode: 'append',
+			state: completedKind,
+			members: rederived,
+			aggregateSha256: sha256(stagedBytes),
+		};
+	} finally {
+		if (stageCreated) await rm(stagePath, { force: true });
+	}
+}
