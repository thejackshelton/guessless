diff --git a/packages/cli/test/react-papercups-aggregate.test.ts b/packages/cli/test/react-papercups-aggregate.test.ts
new file mode 100644
index 0000000..714562c
--- /dev/null
+++ b/packages/cli/test/react-papercups-aggregate.test.ts
@@ -0,0 +1,99 @@
+import { cp, mkdir, mkdtemp, readFile, stat, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { dirname, join } from 'pathe';
+import { describe, expect, it } from 'vitest';
+import {
+	deriveReactPapercupsAggregateMembers,
+	updateReactPapercupsAggregate,
+} from '../src/corpus/react-papercups-aggregate.ts';
+
+const repositoryRoot = process.cwd();
+
+async function workspace(): Promise<string> {
+	const root = await mkdtemp(join(tmpdir(), 'versionless-papercups-aggregate-'));
+	for (const relative of [
+		'evidence/runs/aggregate.json',
+		'evidence/runs/react-papercups-v1-0-0/t004-run.json',
+		'evidence/runs/witness-react-papercups/receipt.json',
+		'evidence/runs/witness-react-papercups/receipt.md',
+	]) {
+		await mkdir(dirname(join(root, relative)), { recursive: true });
+		await cp(join(repositoryRoot, relative), join(root, relative), { recursive: true });
+	}
+	return root;
+}
+
+describe('React Papercups canonical aggregate append', () => {
+	it('derives both members from the published receipts', async () => {
+		const members = await deriveReactPapercupsAggregateMembers(repositoryRoot);
+		expect(members.map((member) => member.id)).toEqual([
+			'react-papercups-v1-0-0',
+			'witness-react-papercups',
+		]);
+		expect(members.every((member) => member.digest.length === 64)).toBe(true);
+	});
+
+	it('appends once and is idempotent thereafter', async () => {
+		const root = await workspace();
+		const first = await updateReactPapercupsAggregate({ rootDir: root, mode: 'append' });
+		expect(first.result).toBe('appended');
+		const bytes = await readFile(join(root, 'evidence/runs/aggregate.json'));
+		const second = await updateReactPapercupsAggregate({ rootDir: root, mode: 'append' });
+		expect(second.result).toBe('already-appended');
+		expect(await readFile(join(root, 'evidence/runs/aggregate.json'))).toEqual(bytes);
+		expect(
+			await updateReactPapercupsAggregate({ rootDir: root, mode: 'verify-only' }),
+		).toMatchObject({ result: 'verified-complete', state: 'react-papercups-browser-proof' });
+	});
+
+	it('verify-only accepts the exact predecessor without changing it', async () => {
+		const root = await workspace();
+		const path = join(root, 'evidence/runs/aggregate.json');
+		const before = await readFile(path);
+		expect(await updateReactPapercupsAggregate({ rootDir: root, mode: 'verify-only' })).toMatchObject({
+			result: 'verified-predecessor',
+			state: 'react-zero-sw-reconciliation',
+		});
+		expect(await readFile(path)).toEqual(before);
+	});
+
+	it('refuses partial and inconsistent Papercups membership', async () => {
+		for (const edit of [
+			(fixtures: unknown[], members: unknown[]) => [...fixtures, members[0]],
+			(fixtures: unknown[], members: unknown[]) => [...fixtures, members[1], members[0]],
+			(fixtures: unknown[], members: unknown[]) => [
+				...fixtures,
+				{ ...(members[0] as object), track: 'drifted' },
+				members[1],
+			],
+		]) {
+			const root = await workspace();
+			const path = join(root, 'evidence/runs/aggregate.json');
+			const aggregate = JSON.parse(await readFile(path, 'utf8')) as { fixtures: unknown[] };
+			const members = await deriveReactPapercupsAggregateMembers(root);
+			aggregate.fixtures = edit(aggregate.fixtures, members);
+			await writeFile(path, `${JSON.stringify(aggregate, null, 2)}\n`);
+			await expect(
+				updateReactPapercupsAggregate({ rootDir: root, mode: 'append' }),
+			).rejects.toThrow();
+		}
+	});
+
+	it('removes its exclusive stage if the atomic rename fails', async () => {
+		const root = await workspace();
+		const aggregatePath = join(root, 'evidence/runs/aggregate.json');
+		const before = await readFile(aggregatePath);
+		await expect(
+			updateReactPapercupsAggregate({
+				rootDir: root,
+				mode: 'append',
+				operations: {
+					rename: async (_source, _target) =>
+						Promise.reject(new Error('injected rename failure')),
+				},
+			}),
+		).rejects.toThrow('injected rename failure');
+		expect(await readFile(aggregatePath)).toEqual(before);
+		await expect(stat(`${aggregatePath}.react-papercups.stage`)).rejects.toThrow();
+	});
+});
