+test('gives CSS virtual documents stable IDs scoped to their TSRX document', () => {
+	const plugin = getMarklessTsrxLanguagePlugin();
+	const source = `export function Page() @{
+	<main>
+		<style>.first { color: red; }</style>
+		<style>.second { color: blue; }</style>
+	</main>
+}`;
+	const firstFileName = '/workspace/src/First.tsrx';
+	const secondFileName = '/workspace/src/Second.tsrx';
+	const create = (fileName: string) =>
+		plugin.createVirtualCode?.(
+			fileName,
+			MARKLESS_TSRX_LANGUAGE_ID,
+			ts.ScriptSnapshot.fromString(source),
+		) as any;
+
+	const first = create(firstFileName);
+	const repeated = create(firstFileName);
+	const second = create(secondFileName);
+	const firstIds = first.embeddedCodes.map((code: any) => code.id);
+
+	expect(firstIds).toHaveLength(2);
+	expect(new Set(firstIds).size).toBe(2);
+	expect(repeated.embeddedCodes.map((code: any) => code.id)).toEqual(firstIds);
+	expect(second.embeddedCodes.map((code: any) => code.id)).not.toEqual(firstIds);
+	expect(first.embeddedCodes.map((code: any) => code.fileName)).toEqual(
+		firstIds.map((id: string) => `${firstFileName}.${id}.css`),
+	);
+});
+
+test('does not add embedded virtual documents to TSRX files without styles', () => {
+	const plugin = getMarklessTsrxLanguagePlugin();
+	const source = 'export function Plain() @{ <p>plain</p> }';
+	const virtualCode = plugin.createVirtualCode?.(
+		'/workspace/src/Plain.tsrx',
+		MARKLESS_TSRX_LANGUAGE_ID,
+		ts.ScriptSnapshot.fromString(source),
+	) as any;
+
+	expect(virtualCode.generatedCode).toContain('<p>plain</p>');
+	expect(virtualCode.embeddedCodes).toEqual([]);
+});
+
