+test('gives CSS virtual codes stable document-scoped IDs', () => {
+	const plugin = getMarklessTsrxLanguagePlugin();
+	const source = `export function App() @{
+	<main>
+		<style>.first { color: red; }</style>
+		<style>.second { color: blue; }</style>
+	</main>
+}`;
+	const firstFileName = '/workspace/src/First.tsrx';
+	const secondFileName = '/workspace/src/Second.tsrx';
+	const createVirtualCode = (fileName: string) =>
+		plugin.createVirtualCode?.(
+			fileName,
+			MARKLESS_TSRX_LANGUAGE_ID,
+			ts.ScriptSnapshot.fromString(source),
+		);
+
+	const firstDocument = createVirtualCode(firstFileName);
+	const repeatedFirstDocument = createVirtualCode(firstFileName);
+	const secondDocument = createVirtualCode(secondFileName);
+
+	expect(firstDocument?.embeddedCodes.map((code) => code.id)).toEqual([
+		`style:${firstFileName}:0`,
+		`style:${firstFileName}:1`,
+	]);
+	expect(repeatedFirstDocument?.embeddedCodes.map((code) => code.id)).toEqual(
+		firstDocument?.embeddedCodes.map((code) => code.id),
+	);
+	expect(secondDocument?.embeddedCodes.map((code) => code.id)).toEqual([
+		`style:${secondFileName}:0`,
+		`style:${secondFileName}:1`,
+	]);
+});
+
+test('does not add embedded virtual codes to documents without styles', () => {
+	const plugin = getMarklessTsrxLanguagePlugin();
+	const virtualCode = plugin.createVirtualCode?.(
+		'/workspace/src/Plain.tsrx',
+		MARKLESS_TSRX_LANGUAGE_ID,
+		ts.ScriptSnapshot.fromString('export function Plain() @{ <p>Plain</p> }'),
+	);
+
+	expect(virtualCode?.embeddedCodes).toEqual([]);
+});
+
