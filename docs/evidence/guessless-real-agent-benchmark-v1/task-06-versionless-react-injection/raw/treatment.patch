+
+	it('preserves reducer and saga injection around the hooks wrapper', async () => {
+		const home = await readFile(
+			path.join(sourceRoot, 'app/containers/HomePage/index.js'),
+			'utf8',
+		);
+		const result = transformHomePageConnectToHooks(home);
+		expect(result.code).toContain("const withReducer = injectReducer({ key: 'home', reducer });");
+		expect(result.code).toContain("const withSaga = injectSaga({ key: 'home', saga });");
+		expect(result.code).toContain(
+			`export default compose(\n  withReducer,\n  withSaga,\n  memo,\n)(HomePageHooks);`,
+		);
+		expect(result.code).not.toContain('withConnect');
+	});
+
+	it('refuses partial reducer or saga injection wiring', async () => {
+		const home = await readFile(
+			path.join(sourceRoot, 'app/containers/HomePage/index.js'),
