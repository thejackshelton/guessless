new file mode 100644
index 0000000..3e02560
--- /dev/null
+++ b/packages/compiler/src/passes/semantic-graph/style-objects.ts
@@ -0,0 +1,254 @@
+import { parseModule } from '@tsrx/core';
+import { asNodes, getIdentifierName, walkNode, type AnyNode } from '../../ast/nodes.ts';
+import { expressionSource } from '../../ast/source.ts';
+
+export type StyleObjectFailure =
+	| 'array'
+	| 'dynamic-key'
+	| 'exported-object'
+	| 'imported-object'
+	| 'mutated-object'
+	| 'runtime-merge'
+	| 'unsupported-object'
+	| 'unsupported-spread';
+
+export type LoweredStyleObject = {
+	readonly cssText: string | null;
+	readonly expressionSource: string;
+	readonly dynamicSources: ReadonlyArray<string>;
+};
+
+type StyleEntry = {
+	readonly name: string;
+	readonly value: AnyNode;
+};
+
+const unitlessProperties = new Set([
+	'animationIterationCount', 'aspectRatio', 'borderImageOutset', 'borderImageSlice',
+	'borderImageWidth', 'boxFlex', 'boxFlexGroup', 'boxOrdinalGroup', 'columnCount',
+	'columns', 'flex', 'flexGrow', 'flexNegative', 'flexOrder', 'flexPositive',
+	'flexShrink', 'floodOpacity', 'fontWeight', 'gridArea', 'gridColumn',
+	'gridColumnEnd', 'gridColumnSpan', 'gridColumnStart', 'gridRow', 'gridRowEnd',
+	'gridRowSpan', 'gridRowStart', 'lineClamp', 'lineHeight', 'opacity', 'order',
+	'orphans', 'scale', 'stopOpacity', 'strokeDasharray', 'strokeDashoffset',
+	'strokeMiterlimit', 'strokeOpacity', 'strokeWidth', 'tabSize', 'widows', 'zIndex',
+	'zoom',
+]);
+
+export function lowerStyleObject(input: {
+	readonly expression: AnyNode;
+	readonly source: string;
+	readonly filename: string;
+}): LoweredStyleObject | { readonly failure: StyleObjectFailure } {
+	const ast = parseModule(input.source, input.filename) as unknown as AnyNode;
+	const resolved = resolveStyleObject(input.expression, ast, input.source, new Set());
+	if ('failure' in resolved) return resolved;
+
+	const entries = new Map<string, StyleEntry>();
+	const flattened = flattenProperties(resolved.object, ast, input.source, new Set());
+	if ('failure' in flattened) return flattened;
+	for (const entry of flattened.entries) entries.set(entry.name, entry);
+
+	const cssParts: string[] = [];
+	const expressionParts: string[] = [];
+	const dynamicSources: string[] = [];
+	let fullyStatic = true;
+	for (const entry of entries.values()) {
+		const propertyName = cssPropertyName(entry.name);
+		const literal = staticStyleValue(entry.name, entry.value);
+		if (literal !== undefined) {
+			if (literal !== null) {
+				const declaration = `${propertyName}:${literal};`;
+				cssParts.push(declaration);
+				expressionParts.push(JSON.stringify(declaration));
+			}
+			continue;
+		}
+
+		fullyStatic = false;
+		const valueSource = expressionSource(entry.value, input.source);
+		if (!valueSource) return { failure: 'unsupported-object' };
+		dynamicSources.push(...dependencyCandidateSources(entry.value, input.source));
+		expressionParts.push(dynamicDeclarationExpression(entry.name, propertyName, valueSource));
+	}
+
+	return {
+		cssText: fullyStatic ? cssParts.join('') : null,
+		expressionSource: expressionParts.length === 0 ? '""' : expressionParts.join(' + '),
+		dynamicSources: [...new Set(dynamicSources)],
+	};
+}
+
+function dependencyCandidateSources(node: AnyNode, source: string): string[] {
+	const candidates: string[] = [];
+	walkNode(node, (candidate) => {
+		if (candidate.type !== 'Identifier' && candidate.type !== 'MemberExpression') return;
+		const value = expressionSource(candidate, source);
+		if (value) candidates.push(value);
+	});
+	return candidates;
+}
+
+function resolveStyleObject(
+	expression: AnyNode,
+	ast: AnyNode,
+	source: string,
+	seen: Set<string>,
+): { readonly object: AnyNode } | { readonly failure: StyleObjectFailure } {
+	if (expression.type === 'ObjectExpression') return { object: expression };
+	if (expression.type === 'ArrayExpression') return { failure: 'array' };
+	if (expression.type === 'CallExpression' || expression.type === 'NewExpression') {
+		return { failure: 'runtime-merge' };
+	}
+	const name = getIdentifierName(expression);
+	if (!name) return { failure: 'unsupported-object' };
+	if (seen.has(name)) return { failure: 'unsupported-spread' };
+	seen.add(name);
+	if (isImported(name, ast)) return { failure: 'imported-object' };
+	const declaration = variableDeclaration(name, ast);
+	if (!declaration) return { failure: 'unsupported-object' };
+	if (declaration.exported) return { failure: 'exported-object' };
+	if (declaration.kind !== 'const') return { failure: 'mutated-object' };
+	if (isMutated(name, ast)) return { failure: 'mutated-object' };
+	const init = declaration.declarator.init as AnyNode | undefined;
+	if (!init) return { failure: 'unsupported-object' };
+	return resolveStyleObject(init, ast, source, seen);
+}
+
+function flattenProperties(
+	object: AnyNode,
+	ast: AnyNode,
+	source: string,
+	seen: Set<string>,
+): { readonly entries: ReadonlyArray<StyleEntry> } | { readonly failure: StyleObjectFailure } {
+	const entries: StyleEntry[] = [];
+	for (const property of asNodes(object.properties)) {
+		if (property.type === 'SpreadElement') {
+			const argument = property.argument as AnyNode | undefined;
+			const name = getIdentifierName(argument);
+			if (!argument || !name || seen.has(name)) return { failure: 'unsupported-spread' };
+			seen.add(name);
+			const resolved = resolveStyleObject(argument, ast, source, new Set());
+			if ('failure' in resolved) return resolved;
+			const spread = flattenProperties(resolved.object, ast, source, seen);
+			if ('failure' in spread) return spread;
+			entries.push(...spread.entries);
+			continue;
+		}
+		if (property.type !== 'Property' || property.kind === 'get' || property.kind === 'set') {
+			return { failure: 'unsupported-object' };
+		}
+		const key = stylePropertyKey(property);
+		if (key === null) return { failure: 'dynamic-key' };
+		const value = property.value as AnyNode | undefined;
+		if (!value) return { failure: 'unsupported-object' };
+		entries.push({ name: key, value });
+	}
+	return { entries };
+}
+
+function stylePropertyKey(property: AnyNode): string | null {
+	const key = property.key as AnyNode | undefined;
+	if (!key) return null;
+	if (property.computed !== true) {
+		const identifier = getIdentifierName(key);
+		if (identifier) return identifier;
+	}
+	if (key.type === 'Literal' && typeof key.value === 'string') return key.value;
+	if (key.type === 'TemplateLiteral' && asNodes(key.expressions).length === 0) {
+		const quasi = asNodes(key.quasis)[0];
+		const value = quasi?.value as { cooked?: unknown } | undefined;
+		return typeof value?.cooked === 'string' ? value.cooked : null;
+	}
+	return null;
+}
+
+function staticStyleValue(name: string, node: AnyNode): string | null | undefined {
+	if (node.type === 'Literal') {
+		if (node.value == null) return null;
+		if (typeof node.value === 'string') return node.value;
+		if (typeof node.value === 'number') return formatStaticNumber(name, node.value);
+		return undefined;
+	}
+	if (node.type === 'Identifier' && node.name === 'undefined') return null;
+	if (node.type === 'UnaryExpression' && node.operator === '-') {
+		const argument = node.argument as AnyNode | undefined;
+		if (argument?.type === 'Literal' && typeof argument.value === 'number') {
+			return formatStaticNumber(name, -argument.value);
+		}
+	}
+	return undefined;
+}
+
+function formatStaticNumber(name: string, value: number): string {
+	return value === 0 || name.startsWith('--') || unitlessProperties.has(name)
+		? String(value)
+		: `${value}px`;
+}
+
+function dynamicDeclarationExpression(name: string, cssName: string, value: string): string {
+	const prefix = JSON.stringify(`${cssName}:`);
+	const suffix = JSON.stringify(';');
+	const formatted = name.startsWith('--') || unitlessProperties.has(name)
+		? 'String(value)'
+		: '(typeof value === "number" && value !== 0 ? value + "px" : String(value))';
+	return `((value) => value == null ? "" : ${prefix} + ${formatted} + ${suffix})(${value})`;
+}
+
+function cssPropertyName(name: string): string {
+	if (name.startsWith('--')) return name;
+	return name.replace(/^ms-/, '-ms-').replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`);
+}
+
+function isImported(name: string, ast: AnyNode): boolean {
+	return asNodes(ast.body).some((statement) =>
+		statement.type === 'ImportDeclaration' &&
+		asNodes(statement.specifiers).some((specifier) =>
+			getIdentifierName(specifier.local as AnyNode | undefined) === name,
+		),
+	);
+}
+
+function variableDeclaration(name: string, ast: AnyNode): {
+	readonly declarator: AnyNode;
+	readonly kind: string | null;
+	readonly exported: boolean;
+} | null {
+	let found: { declarator: AnyNode; kind: string | null; exported: boolean } | null = null;
+	for (const statement of asNodes(ast.body)) {
+		const exportWrapper = statement.type === 'ExportNamedDeclaration' || statement.type === 'ExportDefaultDeclaration';
+		const root = (exportWrapper ? statement.declaration : statement) as AnyNode | undefined;
+		if (!root) continue;
+		const exported = exportWrapper && root.type === 'VariableDeclaration';
+		walkNode(root, (node) => {
+			if (found || node.type !== 'VariableDeclaration') return;
+			for (const declarator of asNodes(node.declarations)) {
+				if (getIdentifierName(declarator.id as AnyNode | undefined) === name) {
+					found = { declarator, kind: typeof node.kind === 'string' ? node.kind : null, exported };
+				}
+			}
+		});
+	}
+	return found;
+}
+
+function isMutated(name: string, ast: AnyNode): boolean {
+	let mutated = false;
+	walkNode(ast, (node) => {
+		if (mutated) return;
+		if (node.type === 'AssignmentExpression' || node.type === 'UpdateExpression') {
+			const target = (node.left ?? node.argument) as AnyNode | undefined;
+			if (rootIdentifier(target) === name) mutated = true;
+		}
+		if (node.type === 'UnaryExpression' && node.operator === 'delete') {
+			if (rootIdentifier(node.argument as AnyNode | undefined) === name) mutated = true;
+		}
+	});
+	return mutated;
+}
+
+function rootIdentifier(node: AnyNode | undefined): string | null {
+	let current = node;
+	while (current?.type === 'MemberExpression') current = current.object as AnyNode | undefined;
+	return getIdentifierName(current);
+}
