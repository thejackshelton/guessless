index 0000000..28fb1c5
--- /dev/null
+++ b/packages/compiler/src/passes/semantic-graph/style-object.ts
@@ -0,0 +1,145 @@
+import { asNodes, getIdentifierName, type AnyNode } from '../../ast/nodes.ts';
+import { expressionSource, sourceSpan } from '../../ast/source.ts';
+import type { SemanticGraphDependency, SemanticGraphDiagnostic } from '../../artifacts.ts';
+import { graphBindingMap, resolveGraphPath, semanticAliasMap } from '../../artifact-helpers/graph-paths.ts';
+import { styleObjectDiagnostic } from './diagnostics.ts';
+import type { WalkState } from './types.ts';
+
+type Entry = { readonly name: string; readonly value: AnyNode };
+type Result = { readonly cssText?: string; readonly graphNodeId?: string; readonly diagnostic?: SemanticGraphDiagnostic };
+
+const unitless = new Set([
+	'animation-iteration-count','aspect-ratio','border-image-outset','border-image-slice','border-image-width',
+	'box-flex','box-flex-group','box-ordinal-group','column-count','columns','flex','flex-grow','flex-negative',
+	'flex-order','flex-positive','flex-shrink','flood-opacity','font-weight','grid-area','grid-column','grid-column-end',
+	'grid-column-span','grid-column-start','grid-row','grid-row-end','grid-row-span','grid-row-start','line-clamp',
+	'line-height','opacity','order','orphans','scale','stop-opacity','stroke-dasharray','stroke-dashoffset',
+	'stroke-miterlimit','stroke-opacity','stroke-width','tab-size','widows','z-index','zoom','fill-opacity',
+]);
+
+export function lowerStyleObject(node: AnyNode, state: WalkState): Result | null {
+	if (node.type === 'ArrayExpression') return failure(state, node, 'MARKLESS_STYLE_OBJECT_ARRAY', 'Style arrays are not supported', 'A style array needs runtime flattening and merge rules.', 'Use one object literal or one immutable const object.');
+	const entries = flattenObject(node, state, new Set());
+	if (!entries) return null;
+	if ('diagnostic' in entries) return entries;
+
+	const dependencies: SemanticGraphDependency[] = [];
+	let reactive = false;
+	for (const entry of entries) {
+		const classification = classifyValue(entry.value, state);
+		if (classification === null) return failure(state, entry.value, 'MARKLESS_STYLE_OBJECT_RUNTIME_MERGE', 'Style values must be compile-time literals or reactive reads', `The value for ${entry.name} requires arbitrary runtime evaluation.`, 'Use a literal, state/computed/prop read, or a template expression composed from those reads.');
+		if (classification.length) reactive = true;
+		dependencies.push(...classification);
+	}
+
+	if (!reactive) return { cssText: entries.map((entry) => staticDeclaration(entry)).filter(Boolean).join('') };
+	const index = state.graph.graphBindings.filter((binding) => binding.id.startsWith('computed:styleObject:')).length;
+	const graphNodeId = `computed:styleObject:${index}`;
+	state.graph.graphBindings.push({
+		id: graphNodeId,
+		name: `marklessStyleObject${index}`,
+		kind: 'computed', writable: false, async: false, asyncCapable: false,
+		functionSource: styleFunction(entries, state),
+		dependencies: uniqueDependencies(dependencies),
+	});
+	return { graphNodeId };
+}
+
+function flattenObject(node: AnyNode, state: WalkState, seen: Set<string>): Entry[] | { diagnostic: SemanticGraphDiagnostic } | null {
+	if (node.type === 'ArrayExpression') return failure(state, node, 'MARKLESS_STYLE_OBJECT_ARRAY', 'Style arrays are not supported', 'A style array would require runtime flattening.', 'Use an object literal.');
+	if (node.type !== 'ObjectExpression') {
+		const name = getIdentifierName(node);
+		if (!name) {
+			const resolved = resolveGraphPath(expressionSource(node, state.source), graphBindingMap(state.graph), semanticAliasMap(state.graph));
+			if (resolved?.path.length === 0 && (resolved.binding.valueKind === 'object' || resolved.binding.valueKind === 'array')) {
+				return failure(state, node, 'MARKLESS_STYLE_OBJECT_STATE', 'Whole reactive style objects are not supported', `${expressionSource(node, state.source)} stores the whole style object in reactive data.`, 'Keep the object shape static and put reactive cells in individual property values.');
+			}
+			return null;
+		}
+		const resolvedWhole = resolveGraphPath(expressionSource(node, state.source), graphBindingMap(state.graph), semanticAliasMap(state.graph));
+		if (resolvedWhole?.path.length === 0 && (resolvedWhole.binding.valueKind === 'object' || resolvedWhole.binding.valueKind === 'array')) {
+			return failure(state, node, 'MARKLESS_STYLE_OBJECT_STATE', 'Whole reactive style objects are not supported', `${name} stores the whole style object in reactive data.`, 'Keep the object shape static and put reactive cells in individual property values.');
+		}
+		if (state.importedNames.has(name)) return failure(state, node, 'MARKLESS_STYLE_OBJECT_IMPORTED', 'Imported style objects are not supported', `${name} is imported, so this file cannot prove its shape or immutability.`, 'Declare an immutable const object in this file.');
+		const span = sourceSpan(node, state.filename);
+		const bindingId = span ? state.resolvedComponentLocalBindingsBySpan.get(`${span.start}:${span.end}`) : undefined;
+		const local = bindingId ? state.componentLocalBindings.get(bindingId) : undefined;
+		if (local) {
+			if (local.declaration.declarationKind !== 'const' || local.declaration.writeCount !== 1) return failure(state, node, 'MARKLESS_STYLE_OBJECT_MUTATED', 'Style objects must be immutable const values', `${name} is reassigned or mutated in this component.`, 'Create one const object that is never changed.');
+			if (!local.initializerNode) return null;
+			if (seen.has(bindingId!)) return failure(state, node, 'MARKLESS_STYLE_OBJECT_RUNTIME_MERGE', 'Cyclic style objects are not supported', `${name} participates in a cyclic style spread.`, 'Remove the cycle and use compile-time const spreads.');
+			seen.add(bindingId!); const result = flattenObject(local.initializerNode, state, seen); seen.delete(bindingId!); return result;
+		}
+		const moduleObject = state.moduleStyleObjectInitializers.get(name);
+		if (!moduleObject) return null;
+		if (moduleObject.exported) return failure(state, node, 'MARKLESS_STYLE_OBJECT_EXPORTED', 'Exported style objects are not supported', `${name} is exported, so it is not a file-private immutable style value.`, 'Keep the const unexported in the same file.');
+		if (moduleObject.mutated) return failure(state, node, 'MARKLESS_STYLE_OBJECT_MUTATED', 'Style objects must be immutable const values', `${name} is mutated in this file.`, 'Create one const object that is never changed.');
+		if (seen.has(name)) return failure(state, node, 'MARKLESS_STYLE_OBJECT_RUNTIME_MERGE', 'Cyclic style objects are not supported', `${name} participates in a cyclic style spread.`, 'Remove the cycle.');
+		seen.add(name); const result = flattenObject(moduleObject.node, state, seen); seen.delete(name); return result;
+	}
+
+	const result = new Map<string, Entry>();
+	for (const property of asNodes(node.properties)) {
+		if (property.type === 'SpreadElement' || property.type === 'SpreadProperty') {
+			const argument = property.argument as AnyNode | undefined;
+			const spread = argument ? flattenObject(argument, state, seen) : null;
+			if (!spread) return failure(state, property, 'MARKLESS_STYLE_OBJECT_RUNTIME_MERGE', 'Runtime style merges are not supported', 'This spread is not a qualifying same-file immutable const object.', 'Spread only inline object literals or immutable, unexported const objects from this file.');
+			if ('diagnostic' in spread) return spread;
+			for (const entry of spread) { result.delete(entry.name); result.set(entry.name, entry); }
+			continue;
+		}
+		if (property.type !== 'Property' && property.type !== 'ObjectProperty') return failure(state, property, 'MARKLESS_STYLE_OBJECT_RUNTIME_MERGE', 'Style accessors and methods are not supported', 'Style objects may contain only data properties.', 'Use ordinary key/value properties.');
+		const key = propertyKey(property);
+		if (key === null) return failure(state, property, 'MARKLESS_STYLE_OBJECT_DYNAMIC_KEY', 'Style keys must be compile-time strings', 'This computed key cannot be determined by the compiler.', 'Use an identifier, string literal, or computed string literal key.');
+		const value = (property.value ?? property.key) as AnyNode | undefined;
+		if (!value) continue;
+		const name = cssName(key); result.delete(name); result.set(name, { name, value });
+	}
+	return [...result.values()];
+}
+
+function propertyKey(property: AnyNode): string | null {
+	const key = property.key as AnyNode | undefined;
+	if (!key) return null;
+	if (property.computed === true) return key.type === 'Literal' && typeof key.value === 'string' ? key.value : null;
+	return getIdentifierName(key) ?? (key.type === 'Literal' && typeof key.value === 'string' ? key.value : null);
+}
+function cssName(name: string): string { if (name.startsWith('--')) return name; return name.replace(/^ms([A-Z])/, '-ms-$1').replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`); }
+function classifyValue(node: AnyNode, state: WalkState): SemanticGraphDependency[] | null {
+	if (staticValue(node) !== undefined || isNullish(node)) return [];
+	const sources = reactiveSources(node, state);
+	if (!sources) return null;
+	const deps: SemanticGraphDependency[] = [];
+	for (const source of sources) {
+		const resolved = resolveGraphPath(source, graphBindingMap(state.graph), semanticAliasMap(state.graph));
+		if (!resolved || !['state','computed','prop'].includes(resolved.binding.kind)) return null;
+		deps.push({ source, graphNodeId: resolved.binding.id, path: resolved.path });
+	}
+	return deps;
+}
+function reactiveSources(node: AnyNode, state: WalkState): string[] | null {
+	if (isNullish(node) || staticValue(node) !== undefined) return [];
+	if (node.type === 'Identifier' || node.type === 'MemberExpression') return [expressionSource(node, state.source)];
+	if (node.type === 'TemplateLiteral') { const parts = asNodes(node.expressions).map((part) => reactiveSources(part, state)); return parts.some((part) => !part) ? null : [...new Set(parts.flatMap((part) => part!))]; }
+	if (node.type === 'BinaryExpression' || node.type === 'LogicalExpression') { const left = reactiveSources(node.left as AnyNode, state); const right = reactiveSources(node.right as AnyNode, state); return left && right ? [...new Set([...left,...right])] : null; }
+	if (node.type === 'ConditionalExpression') { const parts = [node.test,node.consequent,node.alternate].map((part) => reactiveSources(part as AnyNode, state)); return parts.every(Boolean) ? [...new Set(parts.flatMap((part) => part!))] : null; }
+	return null;
+}
+function isNullish(node: AnyNode): boolean { return (node.type === 'Literal' && node.value == null) || (node.type === 'Identifier' && getIdentifierName(node) === 'undefined'); }
+function literalValue(node: AnyNode): string | number | boolean | undefined { return node.type === 'Literal' && node.value != null && ['string','number','boolean'].includes(typeof node.value) ? node.value as string|number|boolean : undefined; }
+function staticValue(node: AnyNode): string | number | boolean | undefined {
+	const literal = literalValue(node);
+	if (literal !== undefined) return literal;
+	if (node.type !== 'TemplateLiteral' || asNodes(node.expressions).length !== 0) return undefined;
+	const quasi = asNodes(node.quasis)[0];
+	const value = quasi?.value as { readonly cooked?: unknown; readonly raw?: unknown } | undefined;
+	return typeof value?.cooked === 'string' ? value.cooked : typeof value?.raw === 'string' ? value.raw : undefined;
+}
+function staticDeclaration(entry: Entry): string { const value = staticValue(entry.value); if (value === undefined || value === false) return ''; return `${entry.name}:${formatStatic(entry.name, value)};`; }
+function formatStatic(name: string, value: string|number|boolean): string { return typeof value === 'number' && value !== 0 && !name.startsWith('--') && !unitless.has(name) ? `${value}px` : String(value); }
+function styleFunction(entries: Entry[], state: WalkState): string {
+	const declarations = entries.map((entry, index) => { const source = expressionSource(entry.value, state.source); const px = !entry.name.startsWith('--') && !unitless.has(entry.name); return `const v${index}=(${source});if(v${index}!=null&&v${index}!==false)css+=${JSON.stringify(`${entry.name}:`)}+(typeof v${index}==="number"&&v${index}!==0&&${px}?v${index}+"px":String(v${index}))+";";`; }).join('');
+	return `() => {let css="";${declarations}return css;}`;
+}
+function uniqueDependencies(items: SemanticGraphDependency[]): SemanticGraphDependency[] { const seen = new Set<string>(); return items.filter((item) => { const key = `${item.graphNodeId}:${item.path.join('.')}`; if (seen.has(key)) return false; seen.add(key); return true; }); }
+function failure(state: WalkState, node: AnyNode, code: Parameters<typeof styleObjectDiagnostic>[0]['code'], title: string, message: string, suggestion: string): { diagnostic: SemanticGraphDiagnostic } { return { diagnostic: styleObjectDiagnostic({ code, title, message, suggestion, node, filename: state.filename }) }; }
