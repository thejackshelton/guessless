+/** Whether this statement suspends the handler itself (nested functions do not). */
+function containsAwait(node: t.Node): boolean {
+	let found = false;
+	const visit = (current: any, root = false): void => {
+		if (found || !current || typeof current !== 'object') return;
+		if (current.type === 'AwaitExpression') {
+			found = true;
+			return;
+		}
+		if (!root && NESTED_FUNCTION_TYPES.has(current.type)) return;
+		for (const [key, value] of Object.entries(current)) {
+			if (['loc', 'range', 'start', 'end', 'comments'].includes(key)) continue;
+			if (Array.isArray(value)) value.forEach((item) => visit(item));
+			else visit(value);
+		}
+	};
+	visit(node, true);
+	return found;
+}
+
+/**
+ * A render-captured state binding is stale after an await. For the narrow case
+ * where a final setter consumes a version computed from that same cell, move
+ * the computation into React's functional updater. Only the updated cell is
+ * rebound: reads of other cells deliberately retain their existing boundary.
+ */
+function lowerPostAwaitSelfReads(
+	fn: t.ArrowFunctionExpression,
+	writable: readonly StateBinding[],
+	context: EmitContext,
+): void {
+	if (!t.isBlockStatement(fn.body)) return;
+	let afterAwait = false;
+	for (let index = 0; index < fn.body.body.length; index += 1) {
+		const statement = fn.body.body[index]!;
+		if (afterAwait && t.isExpressionStatement(statement)) {
+			const call = statement.expression;
+			if (t.isCallExpression(call) && t.isIdentifier(call.callee)) {
+				const state = writable.find(
+					(candidate) =>
+						candidate.storage === 'state' &&
+						setterFor(context, candidate) === call.callee.name,
+				);
+				const argument = call.arguments[0];
+				if (state && t.isIdentifier(argument)) {
+					const declaration = fn.body.body.slice(0, index).findLast(
+						(candidate: any): candidate is t.VariableDeclaration =>
+							t.isVariableDeclaration(candidate, { kind: 'const' }) &&
+							candidate.declarations.length === 1 &&
+							t.isIdentifier(candidate.declarations[0]!.id, {
+								name: argument.name,
+							}),
+					);
+					const initializer = declaration?.declarations[0]!.init;
+					if (initializer && t.isExpression(initializer)) {
+						const probe = t.arrowFunctionExpression([], t.cloneNode(initializer, true));
+						let readsSelf = false;
+						reanalyzeFunction(probe, (module) => {
+							readsSelf = module.unresolvedReferences.some(
+								(reference) => reference.name === state.name,
+							);
+						});
+						if (readsSelf) {
+							const current = context.names.claim(
+								`current${state.name[0]!.toUpperCase()}${state.name.slice(1)}`,
+							);
+							const value = t.cloneNode(initializer, true);
+							replaceFreeNames(value, new Map([[state.name, current]]));
+							call.arguments[0] = t.arrowFunctionExpression(
+								[t.identifier(current)],
+								value,
+							);
+						}
+					}
+				}
+			}
+		}
+		if (containsAwait(statement)) afterAwait = true;
+	}
+}
