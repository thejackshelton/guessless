+function containsTopLevelAwait(node: t.Node): boolean {
+	let found = false;
+	const visit = (value: any, root = false): void => {
+		if (found || !value || typeof value !== 'object') return;
+		if (!root && NESTED_FUNCTION_TYPES.has(value.type)) return;
+		if (value.type === 'AwaitExpression') {
+			found = true;
+			return;
+		}
+		for (const [key, child] of Object.entries(value)) {
+			if (['start', 'end', 'loc', 'comments'].includes(key)) continue;
+			if (Array.isArray(child)) child.forEach((entry) => visit(entry));
+			else visit(child);
+		}
+	};
+	visit(node, true);
+	return found;
+}
+
+function freeNames(node: t.Expression): ReadonlySet<string> {
+	const names = new Set<string>();
+	const fn = t.arrowFunctionExpression([], t.cloneNode(node, true));
+	fn.async = true;
+	reanalyzeFunction(fn, (module) => {
+		for (const reference of module.unresolvedReferences) names.add(reference.name);
+	});
+	return names;
+}
+
+function expandVersionExpression(
+	node: t.Expression,
+	declarations: ReadonlyMap<string, t.VariableDeclaration>,
+	seen: ReadonlySet<string> = new Set(),
+): t.Expression {
+	const expanded = t.cloneNode(node, true);
+	const visit = (value: any): any => {
+		if (!value || typeof value !== 'object') return value;
+		if (t.isIdentifier(value)) {
+			const declaration = declarations.get(value.name);
+			const initializer = declaration?.declarations[0]!.init;
+			if (initializer && t.isExpression(initializer) && !seen.has(value.name)) {
+				const nextSeen = new Set(seen);
+				nextSeen.add(value.name);
+				return expandVersionExpression(initializer, declarations, nextSeen);
+			}
+		}
+		for (const [childKey, child] of Object.entries(value)) {
+			if (['start', 'end', 'loc', 'comments'].includes(childKey)) continue;
+			if (
+				t.isIdentifier(child) &&
+				((value.type === 'MemberExpression' &&
+					childKey === 'property' &&
+					!value.computed) ||
+					(value.type === 'Property' && childKey === 'key' && !value.computed))
+			)
+				continue;
+			if (Array.isArray(child)) value[childKey] = child.map((entry) => visit(entry));
+			else value[childKey] = visit(child);
+		}
+		if (value.type === 'Property' && value.shorthand && value.value !== value.key)
+			value.shorthand = false;
+		return value;
+	};
+	return visit(expanded) as t.Expression;
+}
