+/** Replace only free value references to explicitly configured browser globals. */
+export function rewriteCraBrowserGlobals(
+	code: string,
+	id: string,
+	globals: CraBrowserGlobals,
+): string {
+	const lang = sourceLanguage(id);
+	if (!lang) throw new Error(`Refused: unsupported CRA browser global source ${id}`);
+	const configured = new Map(validatedBrowserGlobals(globals));
+	if (configured.size === 0) return code;
+	const module = analyze(code, { lang, path: pathWithoutQuery(id) });
+	if (module.diagnostics.length)
+		throw new Error(`Refused: CRA browser global analysis diagnostics for ${id}`);
+	const edits = module.unresolvedReferences.flatMap((reference) => {
+		const expression = configured.get(reference.name);
+		if (!expression || reference.space !== 'value') return [];
+		const node = reference.node as typeof reference.node & { start: number; end: number };
+		const parent = module.parentOf(reference.node) as
+			| { type?: string; shorthand?: boolean; key?: unknown; value?: unknown }
+			| null;
+		const replacement = parent?.type === 'Property' && parent.shorthand && parent.value === reference.node
+			? `${reference.name}: ${expression}`
+			: expression;
+		return [{ start: node.start, end: node.end, replacement }];
+	});
+	let output = code;
+	for (const edit of edits.sort((left, right) => right.start - left.start))
+		output = `${output.slice(0, edit.start)}${edit.replacement}${output.slice(edit.end)}`;
+	return output;
+}
