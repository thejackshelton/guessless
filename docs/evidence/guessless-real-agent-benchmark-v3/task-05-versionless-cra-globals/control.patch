+describe('create-react-app browser globals', () => {
+	const processGlobal = {
+		process: { from: 'process/browser', import: 'default' as const },
+	};
+
+	test('imports configured unresolved runtime identifiers without rewriting source text', () => {
+		const plugin = createCraBrowserGlobalsPlugin(processGlobal);
+		const source = [
+			'// process remains a comment',
+			"const label = 'process';",
+			"const record = { process: 'key', value: process.env.NODE_ENV };",
+			'const member = record.process;',
+		].join('\n');
+		expect(plugin.transform(source, '/app/src/index.tsx')).toEqual({
+			code: `import process from "process/browser";\n${source}`,
+			map: null,
+		});
+	});
+
+	test('does not provide a global where the binding is locally shadowed', () => {
+		const plugin = createCraBrowserGlobalsPlugin(processGlobal);
+		const source = 'function inspect(process: { env: object }) { return process.env; }';
+		expect(plugin.transform(source, '/app/src/index.tsx')).toBeNull();
+		expect(plugin.transform('process.env.NODE_ENV', '/app/src/styles.css')).toBeNull();
+	});
+
+	test('supports generic named imports and fails closed on unsupported configuration and writes', () => {
+		const plugin = createCraBrowserGlobalsPlugin({
+			Buffer: { from: 'buffer', import: 'named', name: 'Buffer' },
+		});
+		expect(plugin.transform('Buffer.from("ok")', '/app/src/index.js')?.code).toBe(
+			'import { Buffer as Buffer } from "buffer";\nBuffer.from("ok")',
+		);
+		expect(() =>
