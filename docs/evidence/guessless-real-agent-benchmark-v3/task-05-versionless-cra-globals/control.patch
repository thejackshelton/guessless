+				process: { from: 'process/browser', import: 'side-effect' },
+			} as never),
+		).toThrow('Unsupported CRA browser global import kind');
+		expect(() => plugin.transform('Buffer = replacement;', '/app/src/index.js')).toThrow(
+			'Unsupported write to CRA browser global Buffer',
+		);
+	});
