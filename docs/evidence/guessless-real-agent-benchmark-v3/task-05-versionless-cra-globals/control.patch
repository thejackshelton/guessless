+			if (module.diagnostics.length)
+				throw new Error(`Unsupported CRA browser global source ${id}: analyzer diagnostics`);
+			const needed = new Set<string>();
+			for (const reference of module.unresolvedReferences) {
+				if (!imports.has(reference.name) || reference.inTypePosition) continue;
+				if (reference.isWrite)
+					throw new Error(`Unsupported write to CRA browser global ${reference.name} in ${id}`);
+				needed.add(reference.name);
