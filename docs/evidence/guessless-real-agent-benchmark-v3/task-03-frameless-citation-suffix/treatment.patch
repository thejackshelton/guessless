+export const thirdPartyTargetProblems = (entries = THIRD_PARTY_TARGETS, repositoryRoot = root) => {
+	const problems = [];
+	const seen = new Set();
+	for (const entry of entries) {
+		if (typeof entry.path !== 'string' || entry.path === '') {
+			problems.push(
+				'THIRD_PARTY_TARGETS contains an entry without an exact `path`; suffix rulings are overbroad.',
+			);
+			continue;
+		}
+		if (
+			entry.path.startsWith('/') ||
+			entry.path.includes('node_modules/') ||
+			entry.path.includes('\\') ||
+			entry.path.split('/').some((part) => part === '' || part === '.' || part === '..')
+		)
+			problems.push(
+				`THIRD_PARTY_TARGETS path ${entry.path} is not one anchored relative file path; ` +
+					'absolute and node_modules paths are already ruled and non-normal paths are overbroad.',
+			);
+		if (seen.has(entry.path))
+			problems.push(`THIRD_PARTY_TARGETS repeats ${entry.path}; the duplicate ruling is inert.`);
+		seen.add(entry.path);
