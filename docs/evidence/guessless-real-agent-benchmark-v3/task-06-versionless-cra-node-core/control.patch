+type StringLiteralNode = Readonly<{
+	type: 'Literal';
+	start: number;
+	end: number;
+	value: unknown;
+}>;
+
+function configuredNodeCoreReplacement(
+	specifier: string,
+	mappings: CraNodeCoreModuleMappings,
+): string | null {
+	const canonical = specifier.startsWith('node:') ? specifier.slice('node:'.length) : specifier;
+	return mappings[specifier] ?? mappings[canonical] ?? null;
+}
+
+function literalReplacement(
+	node: StringLiteralNode,
+	mappings: CraNodeCoreModuleMappings,
+): SourceReplacement | null {
+	if (typeof node.value !== 'string') return null;
+	const replacement = configuredNodeCoreReplacement(node.value, mappings);
+	return replacement === null
+		? null
+		: { start: node.start, end: node.end, value: JSON.stringify(replacement) };
+}
+
+/**
+ * Redirect configured Node core-module specifiers to browser implementations.
+ * Syntax and binding analysis deliberately limits the edit to module specifiers
+ * and calls to the ambient CommonJS `require`; strings in application data and
+ * calls through a locally declared `require` are not compatibility surfaces.
+ */
+export function rewriteCraNodeCoreModules(
+	code: string,
+	id: string,
+	mappings: CraNodeCoreModuleMappings,
+): string {
+	const analyzer = new Analyzer();
+	const module = analyzer.addFile(pathWithoutQuery(id), code);
+	const unresolvedRequireNodes = new Set(
+		module.unresolvedReferences
+			.filter((reference) => reference.name === 'require')
+			.map((reference) => reference.node),
+	);
+	const replacements: SourceReplacement[] = [];
+	module.walk({
+		ImportDeclaration(node) {
+			const replacement = literalReplacement(node.source, mappings);
+			if (replacement) replacements.push(replacement);
+		},
+		ExportNamedDeclaration(node) {
+			if (!node.source) return;
+			const replacement = literalReplacement(node.source, mappings);
+			if (replacement) replacements.push(replacement);
+		},
+		ExportAllDeclaration(node) {
+			const replacement = literalReplacement(node.source, mappings);
+			if (replacement) replacements.push(replacement);
+		},
+		ImportExpression(node) {
+			if (node.source.type !== 'Literal') return;
+			const replacement = literalReplacement(node.source, mappings);
+			if (replacement) replacements.push(replacement);
+		},
+		CallExpression(node) {
+			if (
+				node.callee.type !== 'Identifier' ||
+				!unresolvedRequireNodes.has(node.callee) ||
+				node.arguments.length !== 1 ||
+				node.arguments[0]?.type !== 'Literal'
+			)
+				return;
+			const replacement = literalReplacement(node.arguments[0], mappings);
+			if (replacement) replacements.push(replacement);
+		},
+	});
+	return replacements
+		.sort((left, right) => right.start - left.start)
+		.reduce(
+			(output, replacement) =>
+				`${output.slice(0, replacement.start)}${replacement.value}${output.slice(replacement.end)}`,
+			code,
+		);
+}
+
+export function createCraNodeCoreModulePlugin(
+	mappings: CraNodeCoreModuleMappings,
+): CraTransformPlugin {
+	return {
+		name: 'versionless-cra-node-core-modules',
+		enforce: 'pre',
+		transform(code, id) {
+			if (!executableSourceExtensions.has(path.extname(pathWithoutQuery(id)))) return null;
+			const rewritten = rewriteCraNodeCoreModules(code, id, mappings);
+			return rewritten === code ? null : { code: rewritten, map: null };
+		},
+	};
+}
