+export type CraNodeCoreModuleMappings = Readonly<Record<string, string>>;
+
+type SourceReplacement = Readonly<{ start: number; end: number; value: string }>;
+const executableSourceExtensions = new Set([
+	'.js',
+	'.jsx',
+	'.ts',
+	'.tsx',
+	'.mjs',
+	'.mts',
+	'.cjs',
+	'.cts',
