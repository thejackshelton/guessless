+describe('configured Node core modules in browser source', () => {
+	const mappings = { path: 'path-browserify', crypto: 'crypto-browserify' };
+
+	test('rewrites static, dynamic, and ambient require specifiers', () => {
+		const code = [
+			"import path from 'path';",
+			"export { sep } from 'node:path';",
+			"const crypto = import('node:crypto');",
